{
	"name": "aspect-quiz-analyzer",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest watch",
		"test:integration": "playwright test --reporter=dot",
		"test:integration:ui": "playwright test --ui",
		"test": "npm run test:unit && npm run test:integration",
		"lint": "prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --check . && svelte-kit sync && eslint .",
		"format": "prettier --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss --write ."
	},
	"engines": {
		"node": "^24"
	},
	"dependencies": {
		"@fontsource-variable/encode-sans": "^5.1.1",
		"@fontsource-variable/saira": "^5.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.50.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.16.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/d3-scale": "^4.0.8",
		"@types/d3-shape": "^3.1.7",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.0.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.2.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.19.2",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.21.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.0"
		}
	},
	"type": "module"
}
